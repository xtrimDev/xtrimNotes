<!DOCTYPE html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title.split(' ').map(word =>
      word.charAt(0).toUpperCase() + word.slice(1)
    ).join(' ') %></title>
