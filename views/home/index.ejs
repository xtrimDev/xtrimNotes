<%- include("partials/header",{title, accessLevel}) -%>
    <div class="overlay"></div>
    <div class="container">
        <section class="left">
            <div class="top">
                <div class="logo">
                    <div class="icon"></div>
                    <div class="text">
                        <%= setting.appName.split(" ")[0] %> <span class=" text-secondary">
                            <%= setting.appName.split(" ")[1] %></span>
                </div>
            </div>
            <div class=" close">
                                <i class="fas fa-times"></i>
                    </div>
                </div>
                <div class="divider"></div>
                <div class="content" style="margin-left: 1rem;">
                    <% if (homeFolders && homeFolders.length> 0) { %>
                        <ul>
                            <% for (let i=0; i < homeFolders.length; i++) { %>
                                <li class="main-menu">
                                    <div class='course'
                                        onclick="changePageContent('<%= homeFolders[i].path %>', '<%= homeFolders[i].name %>', true)">
                                        <%= homeFolders[i].name %>
                                    </div>
                                </li>
                                <% } %>
                        </ul>
                        <% } %>
                </div>
                <div class="divider"></div>
                <div class="clearfix"></div>
                <div class="bottom">
                    <button class="btn btn-bookmark fa-solid fa-star"
                        onclick="changePageContent('/bookmarks', 'Bookmarks', true)">Bookmarks</button>
                </div>
        </section>
        <section class="right">
            <div class="header">
                <div class="left-section">
                    <div class="line"></div>
                    <div class="telegram-button sm-btn-hide">
                        <a href="<%= setting.teleLink %>" target="_blank">
                            <i class="fab fa-telegram-plane"></i>
                            <span>Join Telegram for Notes</span>
                        </a>
                    </div>
                </div>
                <div class="right-section">
                    <% if (uploader) { %>
                        <div class="actions">
                            <div class="btn xsm-btn-hide" id="add-folder">
                                <i class="fas fa-folder-plus"></i>
                            </div>
                            <div class="btn xsm-btn-hide" id="add-file">
                                <i class="fa-solid fa-file-alt"></i>
                            </div>
                        </div>
                        <% } %>
                            <div class="profile dropdown">
                                <img src="/images/app/8882c204-2c6c-47fa-adf8-aca62ea467.png">
                                <div class="dropdown-content">
                                    <a href="/auth/logout"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
                                </div>
                            </div>
                </div>
            </div>
            <div class="content">
            </div>
        </section>
    </div>
    <div class="viewerContainer" id="viewerContainer">
        <div class="titlebar">
            <div class="leftside">
                <button class="openInTab" id="openInTab" title="open in new tab"><i
                        class="fas fa-external-link-alt"></i></button>
                <button class="bookmark-btn" id="bookmark-btn" title="Bookmark"><i
                        class="icon fa-star fa-regular"></i></button>
            </div>


            <div class="pageTitle" id="pageTitle">Document Preview</div>

            <div class="rightside">
                <button id="closeViewerButton" title="close"><i class="fas fa-close"></i></button></button>
            </div>

        </div>

        <div class="pdfViewer" id="pdfViewer"></div>

        <div class="toolbar">
            <div class="pageInfo">Page: <span id="currentPage">1</span> / <span id="totalPages">1</span></div>
            <div class="pageInfo">
                Go to page:
                <input type="number" id="goto-input" min="1">
                <button id="goto-button">Go</button>
            </div>
        </div>
    </div>
    <% if (userType == "admin" || userType == "owner") { %>
        <div id="custom-context-menu-folder" class="context-menu" style="display: none;">
            <ul>
                <li id="folder-open"><i class="fa fa-folder-open"></i> Open</li>
                <li id="folder-rename"><i class="fa-solid fa-i-cursor"></i> Rename</li>
                <% if (userType == "owner") { %>
                    <li id="folder-info"><i class="fa fa-info-circle"></i> Get Info</li>
                <% } %>
            </ul>
        </div>
        <div id="custom-context-menu-file" class="context-menu" style="display: none;">
            <ul>
                <li id="file-open"><i class="fa fa-file-pdf"></i> Open</li>
                <li id="file-rename"><i class="fa-solid fa-i-cursor"></i> Rename</li>
                <% if (userType == "owner") { %>
                    <li id="file-download"><i class="fa fa-download"></i> Download</li>
                <% } %>
                <li id="file-delete"><i class="fa-regular fa-trash-can"></i> Delete</li>
                <% if (userType == "owner") { %>
                    <li id="file-info"><i class="fa fa-info-circle"></i> Get Info</li>
                <% } %>
            </ul>
        </div>
    <% } %>
    

    <script src="/js/embed.js"></script>
    <script>
        function folderSlug() {
            document.getElementById("folderName").addEventListener("change", function () {
                document.getElementById("slug-folder").value = encodeSlug(this.value);
            })
        }

        function decodeSlug(slug) {
            return slug.replace(/-/g, ' ');
        }

        function encodeSlug(text) {
            return text
                .trim()
                .toLowerCase()
                .replace(/\s+/g, '-')
                .replace(/[^a-z0-9\-\/]+/g, '');
        }

        const loader = `
            <div class="bouncer-loader">
                <div class="bouncing-loader">
                <div></div>
                <div></div>
                <div></div>
                </div>
            </div> `;

        const footer = `
            <div class="footer">
                <div class="footer-item">
                    <div class="icon donation"></div>
                    <div class="text">Want to help us by making a small donation? <span>Donate</span></div>
                </div>
                <div class="footer-item">
                    <div class="icon group"></div>
                    <div class="text">Want to know about me? Check out <span onclick="window.open('https://xtrimdev.github.io/', '_blank')">Contributors</span></div>
                </div>
            </div>`;

        const cache = new Map();
        const Toast = Swal.mixin({
                toast: true,
                position: "top-end",
                showConfirmButton: false,
                timer: 2000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.onmouseenter = Swal.stopTimer;
                    toast.onmouseleave = Swal.resumeTimer;
                }
            });

        async function fetchContent(url, reset = false) {
            if (!reset && cache.has(url)) {
                return cache.get(url);
            }

            return fetch(url, {
                headers: { 'Content-Type': 'application/json' },
                method: "POST",
                body: JSON.stringify({ a: 1, b: 2 })
            })
                .then(response => {
                    if (!response.ok) {
                        if (response.status == 403) {
                            const errData = response.json();

                            if (errData?.banned) {
                                Swal.fire({
                                    title: "Account banned",
                                    text: "Your don't have permission to access the content.",
                                    icon: "error",
                                }).then(() => {
                                    window.location.href = '/auth/login';
                                });
                            }

                            if (!errData?.authenticated) {
                                Swal.fire({
                                    title: "Not authenticated",
                                    text: "Your are not loggedin, login again to access it.",
                                    icon: "error",
                                }).then(() => {
                                    window.location.href = '/auth/login';
                                });

                                return;
                            }
                        } else {
                            Swal.fire({
                                title: "Oops!",
                                text: "Something went wrong!\n Refresh the page and check again",
                                icon: "error",
                            });
                        }
                    }
                    return response.json().then(data => {
                        cache.set(url, data);
                        return data;
                    });
                })
                .catch(error => console.error('Error fetching content:', error));
        }

        async function toggleBookmark(uniqueName, embedTitle) {
            const BookmarkBtn = $("#bookmark-btn");
            const BookmarkBtnIcon = $("#bookmark-btn .icon");

            BookmarkBtnIcon.attr("class", "icon fa-solid fa-spinner fa-spin-pulse");
            BookmarkBtn.attr("disabled", true);

            let data = cache.has("/bookmarks") ? cache.get("/bookmarks") : null;

            if (!data) {
                try {
                    const response = await fetch("/bookmarks", { method: "POST" });
                    if (!response.ok) throw new Error("Failed to fetch bookmarks");
                    data = await response.json();
                    cache.set("/bookmarks", data); // Set the initial cache if not present
                } catch (error) {
                    Toast.fire({
                        icon: "error",
                        title: "Something went wrong"
                    });
                    $(".swal2-container").attr("style", "z-index: 100000 !important;");
                    return;
                }
            }

            const index = data.files.findIndex(file => file.uniqueName === uniqueName);
            const isBookmarked = index >= 0;

            if (isBookmarked) {
                await fetch(`/remove/bookmark/${uniqueName}`, {method: "POST"}).then((response) => response.json()).then((res) => {
                    if (!res.bookmarked) {
                        data.files.splice(index, 1); // Remove the file from data
                        BookmarkBtnIcon.removeAttr("class");
                        BookmarkBtnIcon.attr("class", "icon fa-star fa-regular")

                        Toast.fire({
                            icon: "success",
                            title: "Removed from favorites"
                        });
                    } else {
                        Toast.fire({
                            icon: "error",
                            title: "Something went wrong"
                        });
                    }
                })
            } else {
                await fetch(`/set/bookmark/${uniqueName}`, {method: "POST"}).then((response) => response.json()).then((res) => {
                    if (res.bookmarked) {
                        data.files.push({ name: embedTitle, uniqueName: uniqueName }); // Add the new file
                        BookmarkBtnIcon.removeAttr("class");
                        BookmarkBtnIcon.attr("class", "icon fa-star fa-solid")

                        Toast.fire({
                            icon: "success",
                            title: "Added to favorites"
                        });
                    } else {
                        Toast.fire({
                            icon: "error",
                            title: "Something went wrong"
                        });
                    }
                })
            }

            $(".swal2-container").attr("style", "z-index: 100000 !important;");

            // Explicitly update the cache after modifying the data
            cache.set("/bookmarks", data);

            BookmarkBtn.removeAttr("disabled")
            updateContent(window.location.pathname, document.title);
        }


        async function updateContent(url, title = '', reset = false) {
            $(".container .right .content").html(loader);

            let breadcrumbHtml = updateBreadcrumbs(url);

            const currentUrl = window.location.pathname;
                const newUrl = currentUrl.substring(0, currentUrl.lastIndexOf('/'));

            fetchContent(url, reset).then(data => {
                if (!data) return;

                let folders;
                if (currentUrl == "/")  {
                    folders = data['folders'].map(item => `
            <a class="content folder-menu" onclick="changePageContent('${item.path}', '${item.name}')" data-path="${item.path}" data-name="${item.name}">
                <div class="icon fa-solid fa-graduation-cap"></div>
                <div class="text">${item.name}</div>
            </a>
        `).join('');
                } else {
                    folders = data['folders'].map(item => `
            <a class="content folder-menu" onclick="changePageContent('${item.path}', '${item.name}')" data-path="${item.path}" data-name="${item.name}">
                <div class="icon fa fa-folder"></div>
                <div class="text">${item.name}</div>
            </a>
        `).join('');
                }
                

                const files = data['files'].map(item => `
            <a class="content file-menu" data-embed="${item.uniqueName}" data-name="${item.name}">
                <div class="icon fa fa-file-pdf"></div>
                <div class="text">${item.name}</div>
            </a>
        `).join('');

                const params = newUrl.split("/");

                const previousTitle = decodeSlug(params[params.length - 1]) || "Home";

                if (data['folders'].length == 0 && data['files'].length == 0) {
                    if (currentUrl != "/") {
                        $(".container .right .content").html(`${breadcrumbHtml}<div class="nothing"><div class="img"></div><div class="heading">Nothing found</div><button class="previous" onclick="changePageContent('${(newUrl.trim() == '' ? '/' : newUrl)}', '${previousTitle}')">Go back</button></div>`);
                    } else {
                        $(".container .right .content").html(`${breadcrumbHtml}<div class="nothing"><div class="img"></div><div class="heading">Nothing found</div></div>${footer}`);
                    }
                } else {
                    $(".container .right .content").html(`${breadcrumbHtml}<div class="management">${folders}${files}</div><div class="clearfix"></div>${footer}`);
                }

                if (title) document.title = title;
            });

        }

        function updateBreadcrumbs(path) {
            path = decodeSlug(path);
            const parts = path.split('/').filter(Boolean);
            let breadcrumbHtml = `<div class="breadcrumb"><ul> <li class="home" onclick="changePageContent('/', 'Home')">Home</li>`;
            let currentPath = '';

            let position = 0;

            parts.forEach((part, index) => {
                currentPath += `/${part}`;

                if (index === parts.length - 1) {
                    breadcrumbHtml += ` <li class="${(position == 0 ? 'course' : 'folder')}">${part}</li>`;
                } else {
                    breadcrumbHtml += ` <li class="${(position == 0 ? 'course' : 'folder')}" onclick="changePageContent('${encodeSlug(currentPath)}', '${part}')">${part}</li>`;
                }

                position++;
            });

            breadcrumbHtml += '</ul></div>';

            return breadcrumbHtml;
        }

        function changePageContent(newUrl, newTitle, hide = false) {
            if (hide) {
                const left = document.getElementsByClassName("left");
                left[0].classList.remove("collapse");
            }

            history.pushState({ title: newTitle }, newTitle, newUrl);
            document.title = newTitle;
            updateContent(newUrl, newTitle);

        }

        window.addEventListener('popstate', (event) => {
            const state = event.state;
            const title = state?.title || document.title;
            updateContent(location.pathname, title);

        });

        $(document).ready(() => {
            const initialPath = '<%= path %>';
            const initialTitle = document.title;
            history.replaceState({ title: initialTitle }, initialTitle, initialPath);
            updateContent(initialPath);

        });
    </script>
    <%- include("partials/footer") -%>